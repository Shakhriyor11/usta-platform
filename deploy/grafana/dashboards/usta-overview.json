{
  "uid": "usta-overview",
  "title": "Usta Platform — Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP so'rovlar (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"usta-platform\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 kechikish",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"usta-platform\", uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"usta-platform\", uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx xatoliklar (req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{application=\"usta-platform\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (area) (jvm_memory_used_bytes{application=\"usta-platform\",area=\"heap\"})",
          "legendFormat": "{{area}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox: kutilayotgan / dead",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "outbox_events_pending{application=\"usta-platform\"}",
          "legendFormat": "{{__name__}}"
        },
        {
          "refId": "A",
          "expr": "outbox_events_dead{application=\"usta-platform\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DB connection pool",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{application=\"usta-platform\"}",
          "legendFormat": "{{__name__}}"
        },
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{application=\"usta-platform\"}",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Buyurtmalar oqimi (soatiga)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (to) (increase(orders_transitions_total{application=\"usta-platform\", to=~\"SEARCHING|ACCEPTED|COMMISSION|REVIEWED|EXPIRED|CANCELLED|DISPUTED\"}[1h]))",
          "legendFormat": "{{to}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Hisob-kitob nomuvofiqliklari / xavfli sozlamalar",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(finance_reconciliation_mismatches{application=\"usta-platform\"})",
          "legendFormat": "reconciliation"
        },
        {
          "refId": "B",
          "expr": "max(app_config_warnings{application=\"usta-platform\"}) or vector(0)",
          "legendFormat": "config warnings"
        }
      ]
    },
    {
      "id": 9,
      "type": "alertlist",
      "title": "Faol alertlar",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "options": {
        "alertListOptions": {
          "alertInstanceLabelFilter": "",
          "datasource": "prometheus"
        },
        "viewMode": "list",
        "groupMode": "default",
        "stateFilter": {
          "firing": true,
          "pending": true,
          "normal": false,
          "error": true,
          "noData": false
        },
        "maxItems": 20,
        "showInstances": true,
        "datasource": "Prometheus",
        "sortOrder": 1
      }
    }
  ],
  "tags": [
    "usta"
  ]
}