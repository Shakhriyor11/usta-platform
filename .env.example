# Nusxa oling: cp .env.example .env  — va PRODUCTION uchun barcha parollarni almashtiring!
# .env git'ga qo'shilmaydi.

# --- PostgreSQL
POSTGRES_DB=usta
POSTGRES_USER=usta
POSTGRES_PASSWORD=change-me-postgres

# --- Redis
REDIS_PASSWORD=change-me-redis

# --- MinIO (S3)
MINIO_ROOT_USER=usta-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# --- API
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://usta.uz,https://admin.usta.uz
# Production'da Swagger'ni yoping (yoki faqat ichki tarmoqda oching)
SWAGGER_ENABLED=false
APP_LOG_LEVEL=INFO
# Majburiy (prod): kamida 32 bayt tasodifiy qiymat — openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-at-least-32-bytes-long
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
# Vergul bilan; shu raqamlar OTP orqali kirganda ADMIN roli beriladi
ADMIN_PHONES=+998901234567
# Fayllar (presigned URL) uchun tashqi manzil — nginx /<bucket>/ ni MinIO'ga uzatadi
S3_BUCKET=usta
S3_PUBLIC_ENDPOINT=https://usta.uz

# --- SMS (OTP): log | eskiz. "log" — kod faqat api loglariga yoziladi (lokal)
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Push: log (stub) | fcm (Firebase kalitlari berilganda)
PUSH_PROVIDER=log

# --- Nginx / TLS
# IP bo'yicha limit: mobil operatorlar (CGNAT) ortida ko'p foydalanuvchi bitta IP'da bo'lishi mumkin
NGINX_API_RATE=30r/s
NGINX_API_BURST=60
NGINX_AUTH_RATE=5r/s
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- CD: registry'dagi tayyor image (bo'sh bo'lsa lokal build qilinadi)
# API_IMAGE=ghcr.io/<org>/<repo>/api:v0.1.0

# --- Backup
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Host portlari (band bo'lsa o'zgartiring; hammasi faqat 127.0.0.1 ga bog'langan)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001
# PROMETHEUS_HOST_PORT=9090
# GRAFANA_HOST_PORT=3000
